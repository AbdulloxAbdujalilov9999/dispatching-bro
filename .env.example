# --- Database: Google Sheets ---------------------------------------------
# The Sheet ID is the long string in the sheet's URL:
#   https://docs.google.com/spreadsheets/d/<THIS-PART>/edit
GOOGLE_SHEET_ID="your-sheet-id"

# Service-account credentials. Easiest: paste the ENTIRE downloaded JSON key
# file as one line here (or base64 of it) ...
GOOGLE_SERVICE_ACCOUNT_JSON=""
# ... or set these two instead (keep the \n sequences in the key):
# GOOGLE_SERVICE_ACCOUNT_EMAIL="haulwise@your-project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Optional: Google Drive, only for uploading signed Rate Confirmations --
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""
# GOOGLE_OAUTH_REFRESH_TOKEN=""
# GOOGLE_DRIVE_FOLDER_ID=""   # optional: folder to keep uploads in

# --- Auth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
